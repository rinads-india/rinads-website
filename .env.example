# Environment contract (Phase 1 CORE)

# Public site URL (SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://www.rinads.com

# Auth provider: "demo" (default) | "supabase"
# Keep "demo" until migrations are applied to a Supabase project and keys are set.
NEXT_PUBLIC_AUTH_PROVIDER=demo

# Supabase — browser-safe keys only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY (never prefix with NEXT_PUBLIC_):
# SUPABASE_SERVICE_ROLE_KEY=
#
# Service-role credentials must never appear in client/browser code.
# Use only in trusted server contexts for privileged role assignment / admin ops.
