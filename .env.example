# RINADS environment contract (Phase 0)
# Copy to apps/website/.env.local for local overrides.
# NEVER commit real secrets.

# Public site URL (SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://www.rinads.com

# Supabase — NOT CONNECTED IN PHASE 0
# Future browser-safe keys only:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY (never prefix with NEXT_PUBLIC_):
# SUPABASE_SERVICE_ROLE_KEY=
#
# Service-role credentials must never appear in client/browser code.
# Phase 0 does not use Supabase for production business data.
