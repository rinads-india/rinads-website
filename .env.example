# Environment contract (Phase 1 CORE)

# Public site URL (SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://www.rinads.com
# Public R GLOW origin used in review-request feedback links.
NEXT_PUBLIC_RINAGLOW_URL=https://glow.rinads.com
# Shared Supabase auth-cookie parent domain for Production only. It must be a
# bare leading-dot parent domain (no scheme/path). Leave unset on localhost.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.rinads.com

# Auth provider: "demo" (default) | "supabase"
# Set to supabase after migrations + keys are configured on Vercel/local.
NEXT_PUBLIC_AUTH_PROVIDER=demo

# PRODUCTION ENV CONTRACT (enforced at request time in every app's middleware
# via @rinads/auth assertProductionEnvContract — see packages/auth/src/config.ts):
# On a real Vercel production deployment (VERCEL_ENV=production, set
# automatically by Vercel — do not set manually), the following MUST hold or
# every request will fail with a 500:
#   NEXT_PUBLIC_AUTH_PROVIDER=supabase   (never "demo")
#   USE_DEMO_STORE must NOT be "1"        (unset or "0")
# Required production values (set these in the Vercel project's Production
# environment variables, not in this file):
#   NEXT_PUBLIC_AUTH_PROVIDER=supabase
#   USE_SUPABASE=1
#   USE_DEMO_STORE=0
#   NEXT_PUBLIC_SUPABASE_URL=<production Supabase project URL>
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<production anon key>
#   SUPABASE_SERVICE_ROLE_KEY=<production service role key, server-only>
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET (live keys)

# Supabase — browser-safe keys only
# rinads-platform staging: https://zznigagovilnffyzcrlj.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://zznigagovilnffyzcrlj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY (never prefix with NEXT_PUBLIC_):
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ACCESS_TOKEN=          # CLI: supabase link / db push
# SUPABASE_DB_PASSWORD=           # optional for non-interactive link
# SUPABASE_PROJECT_REF=zznigagovilnffyzcrlj
#
# CMS revalidation (website + platform-admin)
# CMS_REVALIDATE_SECRET=
# WEBSITE_REVALIDATE_URL=https://www.rinads.com/api/revalidate
#
# Phase 12 — Production billing (Razorpay) + Services orders
# NEXT_PUBLIC_RAZORPAY_KEY_ID=   # browser checkout (same as RAZORPAY_KEY_ID)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Webhook URL (after deploy): https://zznigagovilnffyzcrlj.supabase.co/functions/v1/payment-webhook
# Pass service_order_id in Razorpay payment notes for Services checkout
#
# Phase 12 — Storefront domains (Vercel)
# VERCEL_TOKEN=
# VERCEL_STOREFRONT_PROJECT_ID=
# VERCEL_TEAM_ID=
# STOREFRONT_PLATFORM_DOMAIN=store.rinads.com
# STOREFRONT_CUSTOM_DOMAIN_RESOLUTION=1
#
# Phase 12 — Supabase persistence for commerce/ops adapters
# USE_SUPABASE=1
# USE_DEMO_STORE=0
#
# R GLOW — Twilio WhatsApp (Edge Function / worker secrets only; never NEXT_PUBLIC_)
# RINADS_TWILIO_SID=
# RINADS_TWILIO_TOKEN=
# RINADS_TWILIO_WHATSAPP_FROM=
# Status callback: <SUPABASE_URL>/functions/v1/notify-whatsapp-webhook
#
# R GLOW — communications worker (off by default; see docs/runbooks/RGLOW-COMMUNICATIONS-WORKER.md)
# RINADS_COMMUNICATIONS_WORKER_ENABLED=1
# RINADS_CRON_SECRET=
# RINADS_CRON_INVOCATION_TOKEN=
# RINADS_COMMUNICATIONS_ORGANIZATION_IDS=
# RINADS_COMMUNICATIONS_BATCH_SIZE=25
# RINADS_COMMUNICATIONS_THROUGHPUT_DELAY_MS=250
# RINADS_COMMUNICATIONS_MAX_SCHEDULED_CAMPAIGNS=2
# Optional reviews automation after a worker tick:
# RINADS_REVIEWS_AUTOMATION_URL=
# RINADS_REVIEWS_AUTOMATION_TOKEN=
# RINADS_REVIEWS_AUTOMATION_LIMIT=50
#
# R GLOW — loyalty expiry worker (off by default)
# RINADS_LOYALTY_EXPIRY_WORKER_ENABLED=1
# RINADS_LOYALTY_EXPIRY_ORGANIZATION_IDS=
# (falls back to RINADS_COMMUNICATIONS_ORGANIZATION_IDS when unset)
#
# Runtime notification adapters (@rinads/runtime) — honest not_configured without these:
# RINADS_EMAIL_WEBHOOK_URL=          # POST JSON {recipient,templateKey,payload} → 2xx = sent
# SUPABASE_URL=                      # WhatsApp via notify-whatsapp edge function
# SUPABASE_SERVICE_ROLE_KEY=
#
# Optional RINPO LLM NLU (deterministic remains default without key):
# RINADS_RINPO_LLM_API_KEY=
# RINADS_RINPO_LLM_BASE_URL=https://api.openai.com/v1
# RINADS_RINPO_LLM_MODEL=gpt-4o-mini

# Website lead capture (contact / projects). Persistence order:
#   1) LEAD_WEBHOOK_URL (primary CRM / Zapier / etc.)
#   2) else Supabase service role → public.site_leads (see migration)
#   3) else honest ack { ok: true, stored: false } — no invented CRM success
# LEAD_WEBHOOK_URL=
# LEAD_WEBHOOK_SECRET=
# (service-role path reuses NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY)

# Optional analytics sink (POST JSON {event, props, source}). Without this,
# events still land on window.dataLayer / rinadsAnalytics for tag managers.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=
# Optional Google Tag Manager container (injects snippet only when set — never invent an ID).
# NEXT_PUBLIC_GTM_ID=

# Portal URLs used by Business OS deep-links (dev defaults are localhost)
# Production (VERCEL_ENV=production) ignores localhost and uses exact trusted hosts:
#   https://admin.rinads.com / https://app.rinads.com / https://customers.rinads.com / https://glow.rinads.com
# NEXT_PUBLIC_OWNER_PORTAL_URL=http://localhost:3003
# NEXT_PUBLIC_CUSTOMER_PORTAL_URL=http://localhost:3002
# NEXT_PUBLIC_PLATFORM_ADMIN_URL=http://localhost:3004
#
# Platform / portal demo bypass is explicit development only:
#   USE_DEMO_STORE=1 or NEXT_PUBLIC_PLATFORM_DEMO=1 AND development runtime.
# Preview and production always fail closed. Do not set USE_DEMO_STORE=1 there.
#
# Founder bootstrap (service-role, never generates/logs passwords):
#   pnpm admin:bootstrap-founder
# Default email: rinads.india@gmail.com
# Canonical reset origin: https://www.rinads.com/auth/callback?next=/auth/reset-password
# See docs/deployment/VERCEL_INTERNAL_PORTALS.md. Owner/customer UI still uses sample
# adapters — do not treat displayed catalog/orders/tickets as live production data.
